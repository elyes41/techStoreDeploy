[
  { "$match": { "productId": { "@param": "productId" }, "viewedAt": { "$gt": { "@param": "since" } } } },
  { "$group": { "_id": "$visitorId" } },
  { "$limit": 5000 },
  { "$lookup": {
      "from": "product_views",
      "let": { "visitor": "$_id" },
      "pipeline": [
        { "$match": { "$expr": { "$and": [
            { "$eq": ["$visitorId", "$$visitor"] },
            { "$ne": ["$productId", { "@param": "productId" }] },
            { "$gt": ["$viewedAt", { "@param": "since" }] }
        ] } } },
        { "$group": { "_id": "$productId" } }
      ],
      "as": "others"
  } },
  { "$unwind": "$others" },
  { "$group": { "_id": "$others._id", "visitors": { "$sum": 1 } } },
  { "$sort": { "visitors": -1, "_id": 1 } },
  { "$limit": { "@param": "limit" } }
]
